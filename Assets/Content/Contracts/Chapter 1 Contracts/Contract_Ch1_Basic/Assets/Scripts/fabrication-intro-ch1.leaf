# basePath FabricationIntroCh1

::FirstWaferGeneration
@trigger    OnFabPreAttempt
$if temp:fabTutorialStep == 0
    $set temp:fabTutorialStep = 1
    $call HighlightElement(fab:generate-button)
    {@PAL}  Welcome to the fabrication bay!\n\nThis chip only has a metal layer.\n\nThe photolithography process requires five steps for each layer of the chip.
$endif

::FirstMovement
@trigger    OnFabAttempt
$if temp:fabTutorialStep == 1
    $set temp:fabTutorialStep = 2
    {@PAL}  The gray card shows which station to use.
$endif

::ActivateFurnace
@trigger    OnFabArriveAtStation
@when       station == "station:furnace"
$if temp:fabTutorialStep == 2
    {@PAL}  Press the Space to add the wafer, then bring the furnace to the right temperature.
$endif

::GateFurnace
@trigger    OnFabMicrogameCompleted
@when       microgame == "station:furnace"
$call       RequireMicrogamePrecision(0.9)

::StationCompleted
@trigger    OnFabMicrogameExited
$if temp:fabTutorialStep == 2
    $set temp:fabTutorialStep = 3
    {@PAL}  Now follow the gray cards and finish the rest of the tasks.
$endif

::GeneralStun
@trigger    OnFabStunned
$if temp:fabTutorialStep == 2
    {@PAL}  That's the wrong step.\n\nFind the station shown on the gray card.
$else temp:fabTutorialStep != 2
    {@PAL}  That's not the right step.\n\nFind the station shown on the gray card.
$endif 

::MicrogameEntered
@trigger    OnMicrogameEntered
$if temp:fabTutorialStep == 3
    $call MinigameDismissDialogue(Box)
$endif

::GateSpinCoat
@trigger    OnFabMicrogameCompleted
@when       microgame == "station:resist"
$call       RequireMicrogamePrecision(0.8)


::GatePhotolithography
@trigger    OnFabMicrogameCompleted
@when       microgame == "station:photolithography"
$call       RequireMicrogamePrecision(0.9)

::GateEtch
@trigger    OnFabMicrogameCompleted
@when       microgame == "station:etch"
$call       RequireMicrogamePrecision(0.9)