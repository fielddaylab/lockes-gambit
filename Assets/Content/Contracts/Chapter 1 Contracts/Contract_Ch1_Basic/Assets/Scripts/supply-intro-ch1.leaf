# basePath SupplyIntroCh1

:: StartBuilding
@trigger    OnSupplySetupCompleted
$if     MinigameHasValidSolution()
    {@PAL}  You're ready to start the fabrication.
$else
    $call   HighlightElement(supply:ship0)
    $call   CloseWiki()
    {@PAL}  Build a route to complete the contract.\n\nStart by selecting a <color=yellow>HAULER</color>.
$endif

:: FirstShipSelected
@trigger    OnShipSelected
@when       !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  You will need a Conductor for this contract.
$if     !temp:wikiOpened
    $wait   2
    $call   OpenWikiTo("Materials", "Copper")
    $set    temp:wikiOpened = true
$else
    {@PAL}  Select a segment to <color=red>DELETE</color> and build a new route.
$endif
//TODO add highlight pointer to contract


:: FirstNodeClicked
@trigger    OnNodeClicked
@when   !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   HighlightElement(supply:home)
$call   CloseWiki()
{@PAL}  Great. Now click your ship.


:: FirstRouteCompleted
@trigger    OnRouteCompleted
@when   !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   CloseWiki()
$if IsMaterialCollected("Copper")
    $call   HighlightElement(supply:confirm-btn)
    {@PAL}  Click <color=yellow>CONFIRM ROUTES</color> to commit your supply routes./n/n To modify your route, click on a segment to <color=red>DELETE</color>.
$else
    {@PAL}  Uh-oh, this material wasn't a Conductor.\n\nTo modify your route, click on the <color=yellow>HAULER</color>.
    $wait   2
    $call   OpenWikiTo("Materials", "Copper")
$endif


:: OnRouteFullyRemoved
@trigger    OnRouteFullyRemoved
@when   !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   HighlightElement(supply:ship0)
$call   CloseWiki()
{@PAL}  Build a route to complete the contract.\n\nStart by selecting a Hauler.


:: OnRoutesConfirmed
@trigger    OnRoutesConfirmed
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  NOW you're ready to start the fabrication.